node_modules/
dist/
shots/

# Android build output and, above all, signing material. Losing the upload key
# means never being able to update the app again, and committing it means
# anyone can publish as you.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/keystore.properties
*.jks
*.keystore

# A built APK dropped into public/ ends up inside dist/, and then inside the
# next APK. The app shipped a 38 MB copy of itself once; never again.
*.apk
*.aab
*.local
.DS_Store
.vite/
