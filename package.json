{
  "name": "soda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "phone": "vite --host --port 5184 --strictPort",
    "tunnel": "npx --yes localtunnel --port 5184",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:bundle": "vite build && cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "vite": "^7.0.0"
  }
}
