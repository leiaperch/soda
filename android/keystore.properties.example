# Copy to android/keystore.properties and fill in. That file is gitignored.
#
# Create the upload key once:
#
#   keytool -genkeypair -v -keystore soda-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias soda
#
# Then BACK THE .jks UP somewhere you will still have in five years. Losing it
# means you can never publish an update to the app under the same listing.
# Keep it out of the repository, always.

storeFile=../soda-upload.jks
storePassword=CHANGE_ME
keyAlias=soda
keyPassword=CHANGE_ME
